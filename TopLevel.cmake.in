cmake_minimum_required(VERSION 3.21)

project(@NAME@ VERSION 0.1.0 LANGUAGES C CXX)

option(@NAME@_BUILD_TESTING "Build the @NAME@ tests" ${PROJECT_IS_TOP_LEVEL})
set(@NAME@_CXX_STANDARD 20 CACHE STRING "C++ standard for @NAME@")

include(GNUInstallDirs)
set(@NAME@_INSTALL_BINDIR ${CMAKE_INSTALL_BINDIR})
set(@NAME@_INSTALL_LIBDIR ${CMAKE_INSTALL_LIBDIR})
set(@NAME@_INSTALL_INCLUDEDIR ${CMAKE_INSTALL_INCLUDEDIR})
set(@NAME@_INSTALL_CONFDIR ${@NAME@_INSTALL_LIBDIR}/cmake/@NAME@-${PROJECT_VERSION})

list(INSERT CMAKE_MODULE_PATH 0 ${PROJECT_SOURCE_DIR}/cmake)
include(@NAME@_deps)

add_subdirectory(src)

if(@NAME@_BUILD_TESTING)
  include(CTest)
  if(BUILD_TESTING)
    add_subdirectory(test)
  endif()
endif()

install(EXPORT @NAME@_EXPORTS
  NAMESPACE @NAME@::
  FILE @NAME@-exports.cmake
  DESTINATION ${@NAME@_INSTALL_CONFDIR})

configure_file(@NAME@-config.cmake.in @NAME@-config.cmake @ONLY)

# A 0.x project can change its interface at each minor version.
# Thus for 0.x, a consumer gets the package only when the minor version
# is the same. From 1.0, only a major version can change the interface.
if(PROJECT_VERSION_MAJOR EQUAL 0)
  set(@NAME@_VERSION_COMPATIBILITY SameMinorVersion)
else()
  set(@NAME@_VERSION_COMPATIBILITY SameMajorVersion)
endif()
include(CMakePackageConfigHelpers)
write_basic_package_version_file(
  ${PROJECT_BINARY_DIR}/@NAME@-config-version.cmake
  COMPATIBILITY ${@NAME@_VERSION_COMPATIBILITY})

install(FILES
  ${PROJECT_BINARY_DIR}/@NAME@-config.cmake
  ${PROJECT_BINARY_DIR}/@NAME@-config-version.cmake
  DESTINATION ${@NAME@_INSTALL_CONFDIR})
